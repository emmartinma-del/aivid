# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── ElevenLabs (optional for MVP – falls back to OpenAI TTS) ─────────────────
ELEVENLABS_API_KEY=

# ─── OpenAI (TTS fallback) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Pixabay (free music) ─────────────────────────────────────────────────────
PIXABAY_API_KEY=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Shared JWT secret between FastAPI and NextAuth
JWT_SECRET=change-me-in-production-min-32-chars
NEXTAUTH_SECRET=change-me-in-production-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# ─── AWS S3 (production) ─────────────────────────────────────────────────────
# Leave empty to use MinIO locally
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_UPLOADS_BUCKET=aivid-uploads
S3_OUTPUTS_BUCKET=aivid-outputs
CLOUDFRONT_DOMAIN=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aivid:aivid_dev@localhost:5432/aivid

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@aivid.ch

# ─── Frontend URL ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
